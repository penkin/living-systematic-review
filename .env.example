# Copy to .env and fill in. .env is git-ignored; never commit it.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
SIGNAL_MODEL=anthropic/claude-haiku-4.5
SIGNAL_CONCURRENCY=8
# Error pages with the traceback. Never 1 when hosted.
DJANGO_DEBUG=1

# Hosting only. See docs/hosting.md. Leave unset locally.
# DJANGO_ALLOWED_HOSTS=your-host.example.org
# SIGNAL_DB=/data/db.sqlite3
# DJANGO_SECRET_KEY=
# APP_PASSWORD=
