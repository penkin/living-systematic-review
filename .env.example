# Copy to .env and fill in. .env is git-ignored; never commit it.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
SIGNAL_MODEL=anthropic/claude-haiku-4.5
SIGNAL_CONCURRENCY=8

# Hosting. fly.toml sets the first three; the rest are Fly secrets. Leave unset locally.
# DJANGO_DEBUG=0
# DJANGO_ALLOWED_HOSTS=signal-tool.fly.dev
# SIGNAL_DB=/data/db.sqlite3
# DJANGO_SECRET_KEY=
# APP_PASSWORD=
